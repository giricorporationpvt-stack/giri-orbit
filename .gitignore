# Giri Orbit — .gitignore
# OS & Editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/

# Build artifacts
dist/
build/
*.min.js.map

# Temp & scratch
scratch/
*.tmp
*.bak

# Flask
*.pyc
instance/

# Secrets
.env
.env.local
